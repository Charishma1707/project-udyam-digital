# Sarvam AI API Configuration
# Get your API key from https://www.sarvam.ai/
SARVAM_API_KEY=your_sarvam_api_key_here

# Application Server Port
PORT=8000

# Optional: PostgreSQL Database Connection
# If not provided or offline, the system automatically falls back to the in-memory persistence store.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/airtel_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=airtel_db
